# Optional future LLM/RAG backend configuration.
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_VECTOR_STORE_ID=

# Optional local overrides for `pnpm sync:vector-store`.
OPENAI_VECTOR_STORE_DOCS_DIR=docs
OPENAI_VECTOR_STORE_EXCLUDED_PATHS=x/tweetsForStore.jsonl
OPENAI_SYNC_DELETE_FILES=true

# Telegram notifications for prompts and Connect emails.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: if set, instrumentation.ts registers this URL with Telegram on app startup.
TELEGRAM_WEBHOOK_URL=https://haltakov.com/api/telegram-webhook
# Optional but recommended for /api/telegram-webhook. Sent to Telegram as the webhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Optional: lock operator replies to one Telegram user id inside TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_USER_ID=
